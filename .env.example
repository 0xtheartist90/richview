# Copy to .env.local and fill in. Never commit real values.

# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
# Server only (bypasses RLS). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# The password that unlocks RichView in a browser (Richie only). Pick a long one.
ADMIN_PASSWORD=

# Vercel sends this to /api/cron/recurring (the daily recurring tasks). Any long random string.
CRON_SECRET=
